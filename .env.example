# NestJS Configuration
NODE_ENV=production
PORT=5000

# Database (PostgreSQL via Prisma)
# Docker containers reach host services via "host-gateway" special hostname
DATABASE_URL=postgresql://user:password@host-gateway:5432/production_monitoring

# Redis Configuration
# Docker containers reach host services via "host-gateway" special hostname
REDIS_HOST=host-gateway
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT Broker Configuration
# Docker containers reach host services via "host-gateway" special hostname
MQTT_BROKER_URL=mqtt://host-gateway:1883
MQTT_USER=
MQTT_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Job Scheduler Configuration
# Timezone reference: https://en.wikipedia.org/wiki/Tz_database
SNAPSHOT_DAILY_CRON=0 5 * * *
SNAPSHOT_WEEKLY_CRON=0 10 * * 0
EXPORT_WEEKLY_CRON=0 22 * * 1

# Data Retention
TTL_DAYS=450

# Export Configuration
EXPORT_PATH=./exports
